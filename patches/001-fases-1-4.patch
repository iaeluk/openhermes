+  '█  █ ▀▀▀▀ ▀  ▀ ▀  ▀ ▀▀▀▀ ▀▀▀▀'
+]
+
+export const OpencodeIntro = memo(function OpencodeIntro({ t }: { t: Theme }) {
+  return (
+    <Box alignItems="center" flexDirection="column" paddingY={1}>
+      {BLOCK_LOGO.map((line, i) => (
+        <Text color={t.color.text} key={i}>
+          {line}
+        </Text>
+      ))}
+    </Box>
+  )
+})
+
+export const OpencodeBand = memo(function OpencodeBand({
+  children,
+  t
+}: {
+  children: ReactNode
+  t: Theme
+}) {
+  return (
+    <Box
+      borderBottom={false}
+      borderColor={t.color.accent}
+      borderRight={false}
+      borderStyle="single"
+      borderTop={false}
+      flexDirection="column"
+      paddingX={1}
+    >
+      {children}
+    </Box>
+  )
+})
+
+export const OpencodeModelLine = memo(function OpencodeModelLine({
+  agent,
+  model,
+  provider,
+  t,
+  tier
+}: {
+  agent: string
+  model: string
+  provider?: string
+  t: Theme
+  tier?: string
+}) {
+  if (!model) {
+    return null
+  }
+
+  const where = [model, provider].filter(Boolean).join(' ')
+
+  return (
+    <Box paddingX={1}>
+      <Text color={t.color.muted} wrap="truncate-end">
+        <Text bold color={t.color.accent}>
+          {agent}
+        </Text>
+        {` · ${where}`}
+        {tier ? ` · ${tier}` : ''}
+      </Text>
+    </Box>
+  )
+})
+
+// Hints row under the composer, exactly like the preview:
+// `~` on the left, shortcuts on the right.
+export const OpencodeHints = memo(function OpencodeHints({ t }: { t: Theme }) {
+  return (
+    <Box flexDirection="row" justifyContent="space-between" paddingX={1}>
+      <Text color={t.color.muted}>~</Text>
+      <Text color={t.color.muted}>
+        <Text color={t.color.text}>shift+tab</Text>
+        {' agentes  '}
+        <Text color={t.color.text}>ctrl+p</Text>
+        {' comandos'}
+      </Text>
+    </Box>
+  )
+})
+
+const countEntries = (rec?: Record<string, string[]> | null): number =>
+  rec ? Object.values(rec).reduce((n, arr) => n + (arr?.length ?? 0), 0) : 0
+
+export const OpencodeStatusBar = memo(function OpencodeStatusBar({
+  fresh,
+  info,
+  t,
+  usage
+}: {
+  fresh: boolean
+  info?: SessionInfo | null
+  t: Theme
+  usage?: Usage | null
+}) {
+  if (fresh) {
+    const tools = countEntries(info?.tools)
+    const skills = countEntries(info?.skills)
+
+    return (
+      <Box flexDirection="row" justifyContent="space-between" paddingX={1}>
+        <Text color={t.color.muted} wrap="truncate-end">
+          {`⊙ ${tools} ferramentas · ${skills} skills`}
+        </Text>
+        <Text color={t.color.muted}>{info?.version ?? ''}</Text>
+      </Box>
+    )
+  }
+
+  const used = usage?.context_used ?? 0
+  const pct = usage?.context_percent ?? 0
+
+  const cost = usage?.cost_usd ?? (typeof usage?.dev_credits_spent_micros === 'number'
+    ? usage.dev_credits_spent_micros / 1_000_000
+    : 0)
+
+  return (
+    <Box flexDirection="row" justifyContent="space-between" paddingX={1}>
+      <Text color={t.color.muted} wrap="truncate-end">
+        {`${compactNumber(used)} (${Math.round(pct)}%) · $${cost.toFixed(2)}`}
+      </Text>
+      <Text color={t.color.muted}>
+        <Text bold color={t.color.text}>ctrl+p</Text>
+        {' commands'}
+      </Text>
+    </Box>
+  )
+})
+
+// Per-answer meta line, like the preview:
+// `AGENT · model · 1.8s · 42.5 tok/s` (session averages, same numbers as status).
+export const OpencodeMeta = memo(function OpencodeMeta({
+  agent,
+  model,
+  t,
+  usage
+}: {
+  agent: string
+  model: string
+  t: Theme
+  usage?: Usage | null
+}) {
+  const parts = [agent, model]
+
+  if (typeof usage?.avg_latency_s === 'number') {
+    parts.push(`${usage.avg_latency_s.toFixed(1)}s`)
+  }
+
+  if (typeof usage?.avg_tps === 'number') {
+    parts.push(`${usage.avg_tps.toFixed(1)} tok/s`)
+  }
+
+  if (parts.length <= 2) {
+    return null
+  }
+
+  return (
+    <Box paddingX={1}>
+      <Text color={t.color.muted} wrap="truncate-end">
+        {parts.join(' · ')}
+      </Text>
+    </Box>
+  )
+})
+
+const TAB_TITLE_LEN = 24
+const TABS_POLL_MS = 6000
+
+export interface OpencodeTabsProps {
+  fresh: boolean
+  onClose: (id: string) => void
+  onNew: () => void
+  onSelect: (id: string) => void
+  t: Theme
+}
+
+export const OpencodeTabs = memo(function OpencodeTabs({ fresh, onClose, onNew, onSelect, t }: OpencodeTabsProps) {
+  const { gw } = useGateway()
+  const sid = useStore($uiSessionId)
+  const [tabs, setTabs] = useState<SessionActiveItem[]>([])
+
+  const refresh = useCallback(() => {
+    void (async () => {
+      try {
+        const r = await gw.request<SessionActiveListResponse>('session.active_list', {})
+        const rows = (r as SessionActiveListResponse | null)?.sessions
+
+        if (rows) {
+          setTabs(rows)
+        }
+      } catch {
+        // Keep last-good list; a transient failure must not blank the bar.
+      }
+    })()
+  }, [gw])
+
+  useEffect(() => {
+    refresh()
+  }, [refresh, sid])
+
+  useEffect(() => {
+    const id = setInterval(refresh, TABS_POLL_MS)
+
+    return () => clearInterval(id)
+  }, [refresh])
+
+  // openhermes: close mirrors ActiveSessionSwitcher — refresh now, and when
+  // the current session died adopt a fallback (another live tab, else a new
+  // session) so the TUI never sits on a dead session.
+  const handleClose = useCallback((id: string) => {
+    void (async () => {
+      try {
+        await onClose(id)
+      } catch {
+        // A failed close just leaves the tab; the refresh below repairs it.
+      }
+
+      try {
+        const list = await gw.request<SessionActiveListResponse>('session.active_list', {})
+        const rows = list?.sessions ?? []
+        setTabs(rows)
+
+        if (sid != null && id === sid) {
+          const next = rows.find(t => t.id !== id) ?? rows[0]
+
+          if (next) {
+            onSelect(next.id)
+          } else {
+            onNew()
+          }
+        }
+      } catch {
+        // Keep last-good list; the poll retries.
+      }
+    })()
+  }, [gw, onClose, onNew, onSelect, sid])
+
+  if (tabs.length <= 1 && fresh) {
+    return null
+  }
+
+  return (
+    <Box flexDirection="row" paddingX={1}>
+      {tabs.map(tab => {
+        const active = tab.current || (sid != null && tab.id === sid)
+        const title = (tab.title || tab.preview || tab.id).slice(0, TAB_TITLE_LEN)
+
+        return (
+          <Box flexDirection="row" key={tab.id}>
+            <Box onClick={() => onSelect(tab.id)}>
+              <Text
+                backgroundColor={active ? t.color.statusBg : undefined}
+                bold={active}
+                color={active ? t.color.text : t.color.muted}
+              >
+                {` ${title} `}
+              </Text>
+            </Box>
+            <Box onClick={() => handleClose(tab.id)}>
+              <Text color={t.color.muted}>{' ×'}</Text>
+            </Box>
+          </Box>
+        )
+      })}
+      {!fresh && (
+        <Box onClick={() => onNew()}>
+          <Text color={t.color.muted}>{' + New session'}</Text>
+        </Box>
+      )}
+    </Box>
+  )
+})
diff --git a/ui-tui/src/components/opencodePalette.tsx b/ui-tui/src/components/opencodePalette.tsx
new file mode 100644
index 0000000000..9a4058b089
--- /dev/null
+++ b/ui-tui/src/components/opencodePalette.tsx
@@ -0,0 +1,389 @@
+import { Box, Text, useInput } from '@hermes/ink'
+import { useStore } from '@nanostores/react'
+import { memo, useCallback, useEffect, useRef, useState } from 'react'
+
+import { useGateway } from '../app/gatewayContext.js'
+import { patchOverlayState } from '../app/overlayStore.js'
+import { $uiState } from '../app/uiStore.js'
+import { detectLightMode } from '../theme.js'
+import type { Theme } from '../theme.js'
+
+// openhermes Fase 3: Ctrl+P command palette. Views: commands, settings,
+// themes. Models/sessions reuse the existing pickers. Name (skin branding)
+// needs a backend RPC first — see TODO in Fase 5 notes, not shipped here.
+
+type View = 'commands' | 'settings' | 'themes'
+
+const THEME_NAMES = [
+  'aura', 'ayu', 'carbonfox', 'catppuccin', 'catppuccin-frappe',
+  'catppuccin-macchiato', 'cobalt2', 'cursor', 'dracula', 'everforest',
+  'flexoki', 'github', 'gruvbox', 'kanagawa', 'lucent-orng', 'material',
+  'matrix', 'mercury', 'monokai', 'nightowl', 'nord', 'one-dark',
+  'opencode', 'orng', 'osaka-jade', 'palenight', 'rosepine', 'solarized',
+  'synthwave84', 'tokyonight', 'vercel', 'vesper', 'zenburn'
+]
+
+const COLOR_MODES = ['auto', 'light', 'dark']
+
+// openhermes: exact port of the preview theme rules. A theme NAME resolves
+// to `oh-<name>` (dark) or `oh-<name>-light` through the effective color
+// mode: explicit light/dark wins, `auto` follows terminal detection.
+export const themeNameFromSkin = (skin: string): string | null => {
+  const m = /^oh-(.+?)(-light)?$/.exec(skin)
+
+  return m ? m[1] : null
+}
+
+export const resolveSkin = (name: string, colorMode: string): string => {
+  const mode = colorMode === 'light' || colorMode === 'dark'
+    ? colorMode
+    : detectLightMode() ? 'light' : 'dark'
+
+  return mode === 'light' ? `oh-${name}-light` : `oh-${name}`
+}
+
+interface PaletteRow {
+  hint?: string
+  label: string
+  run: () => void
+  value?: string
+}
+
+export interface OpencodePaletteProps {
+  onCancel: () => void
+  onNewSession: () => void
+  onOpenConnectors: () => void
+  onOpenModelPicker: () => void
+  onOpenPluginsHub: () => void
+  onOpenSessions: () => void
+  onOpenSkillsHub: () => void
+  t: Theme
+}
+
+export const OpencodePalette = memo(function OpencodePalette({
+  onCancel,
+  onNewSession,
+  onOpenConnectors,
+  onOpenModelPicker,
+  onOpenPluginsHub,
+  onOpenSessions,
+  onOpenSkillsHub,
+  t
+}: OpencodePaletteProps) {
+  const { rpc } = useGateway()
+  const uiLayout = useStore($uiState).layout
+  const [view, setView] = useState<View>('commands')
+  const [filter, setFilter] = useState('')
+  const [activeIdx, setActiveIdx] = useState(0)
+  const [values, setValues] = useState<Record<string, string>>({})
+  // openhermes: skin active when the themes view opened — Esc reverts to it,
+  // exactly like the preview (prevTheme).
+  const entrySkinRef = useRef('')
+  const [currentSkin, setCurrentSkin] = useState('')
+  const [err, setErr] = useState('')
+
+  useEffect(() => {
+    if (view !== 'settings') {
+      return
+    }
+    void (async () => {
+      const out: Record<string, string> = {}
+
+      for (const k of ['skin', 'reasoning', 'theme']) {
+        try {
+          const r = (await rpc('config.get', { key: k })) as {
+            display?: unknown
+            value?: unknown
+          } | null
+
+          // `reasoning` reports {value: effort, display: show|hide}.
+          out[k] = k === 'reasoning' ? String(r?.display ?? '') : String(r?.value ?? '')
+        } catch {
+          out[k] = ''
+        }
+      }
+
+      setValues(out)
+    })()
+  }, [rpc, view])
+
+  useEffect(() => {
+    if (view !== 'themes') {
+      return
+    }
+    void (async () => {
+      try {
+        const [s, m] = await Promise.all([
+          rpc('config.get', { key: 'skin' }) as Promise<{ value?: unknown } | null>,
+          rpc('config.get', { key: 'theme' }) as Promise<{ value?: unknown } | null>
+        ])
+
+        const skin = String(s?.value ?? '')
+        setCurrentSkin(skin)
+        setValues(prev => ({ ...prev, theme: String(m?.value ?? '') }))
+        // Snapshot for Esc-revert + highlight where you are (preview parity).
+        entrySkinRef.current = skin
+        const name = themeNameFromSkin(skin)
+        setActiveIdx(name ? Math.max(0, THEME_NAMES.indexOf(name)) : 0)
+      } catch {
+        setCurrentSkin('')
+      }
+    })()
+  }, [rpc, view])
+
+  const setConfig = useCallback((key: string, value: string, local?: Record<string, string>) => {
+    void (async () => {
+      try {
+        await rpc('config.set', { key, value })
+        setErr('')
+
+        if (local) {
+          setValues(prev => ({ ...prev, ...local }))
+        }
+      } catch (e) {
+        setErr(e instanceof Error ? e.message : String(e))
+      }
+    })()
+  }, [rpc])
+
+  const colorMode = values['theme'] || 'auto'
+  const skinFor = (name: string) => resolveSkin(name, colorMode)
+
+  const applyTheme = (name: string) => {
+    const skin = skinFor(name)
+    setCurrentSkin(skin)
+    setConfig('skin', skin)
+  }
+
+  const cycleColorMode = () => {
+    const next = COLOR_MODES[(COLOR_MODES.indexOf(colorMode) + 1) % COLOR_MODES.length] ?? 'auto'
+    setConfig('theme', next, { theme: next })
+    // Re-apply the current theme through the new mode (preview parity).
+    const name = themeNameFromSkin(currentSkin)
+
+    if (name) {
+      const skin = resolveSkin(name, next)
+      setCurrentSkin(skin)
+      setConfig('skin', skin)
+    }
+  }
+
+  const go = (v: View) => {
+    setView(v)
+    setFilter('')
+    setActiveIdx(0)
+  }
+
+  const rows: { group: string; items: PaletteRow[] }[] = []
+
+  if (view === 'commands') {
+    rows.push(
+      {
+        group: 'Suggested',
+        items: [
+          { hint: 'ctrl+x l', label: 'Switch session', run: onOpenSessions },
+          { hint: 'ctrl+x m', label: 'Switch model', run: onOpenModelPicker },
+          { label: 'Open settings', run: () => go('settings') }
+        ]
+      },
+      {
+        group: 'Session',
+        items: [
+          { hint: 'ctrl+x l', label: 'Switch session', run: onOpenSessions },
+          { hint: 'ctrl+x n', label: 'New session', run: onNewSession },
+          { hint: 'ctrl+o', label: 'Open session or project', run: onOpenSessions }
+        ]
+      },
+      {
+        group: 'Tools',
+        items: [
+          { label: 'Skills', run: onOpenSkillsHub },
+          { label: 'Plugins', run: onOpenPluginsHub },
+          { label: 'Connect an integration', run: onOpenConnectors }
+        ]
+      },
+      {
+        group: 'Appearance',
+        items: [
+          { label: 'Switch theme', run: () => go('themes') },
+          { label: 'Color mode', run: cycleColorMode }
+        ]
+      }
+    )
+  } else if (view === 'settings') {
+    rows.push(
+      {
+        group: 'Appearance',
+        items: [
+          { label: 'Theme', run: () => go('themes'), value: values['skin'] || currentSkin },
+          {
+            label: 'Color mode',
+            run: cycleColorMode,
+            value: values['theme'] || 'auto'
+          },
+          {
+            label: 'Layout',
+            run: () => setConfig('layout', uiLayout === 'opencode' ? 'classic' : 'opencode'),
+            value: uiLayout
+          }
+        ]
+      },
+      {
+        group: 'Session',
+        items: [
+          { label: 'Model', run: onOpenModelPicker },
+          {
+            label: 'Reasoning',
+            run: () => {
+              const next = values['reasoning'] === 'hide' ? 'show' : 'hide'
+              setConfig('reasoning', next, { reasoning: next })
+            },
+            value: values['reasoning'] === 'hide' ? 'off' : 'on'
+          }
+        ]
+      }
+    )
+  } else {
+    const q = filter.toLowerCase()
+    rows.push({
+      group: 'Themes',
+      items: THEME_NAMES.filter(n => n.includes(q)).map(n => ({
+        label: `${currentSkin === skinFor(n) ? '● ' : '  '}${n}`,
+        // Hover already applied it live (preview parity) — Enter confirms.
+        run: () => onCancel()
+      }))
+    })
+  }
+
+  const q = filter.toLowerCase()
+
+  const visible =
+    view === 'themes'
+      ? rows
+      : rows
+          .map(g => ({
+            ...g,
+            items: g.items.filter(r => r.label.toLowerCase().includes(q))
+          }))
+          .filter(g => g.items.length > 0)
+
+  const flat = visible.flatMap(g => g.items)
+  const clamped = flat.length ? Math.min(activeIdx, flat.length - 1) : 0
+
+  // openhermes: navigating the themes list previews live, exactly like the
+  // preview (hover = apply, Enter = confirm, Esc = revert to entry skin).
+  const previewSkin = (() => {
+    if (view !== 'themes') {
+      return null
+    }
+
+    const names = THEME_NAMES.filter(n => n.includes(filter.toLowerCase()))
+    const name = names[Math.min(activeIdx, Math.max(0, names.length - 1))]
+
+    return name ? skinFor(name) : null
+  })()
+
+  useEffect(() => {
+    if (previewSkin && previewSkin !== currentSkin) {
+      setCurrentSkin(previewSkin)
+      setConfig('skin', previewSkin)
+    }
+  }, [currentSkin, previewSkin, setConfig])
+
+  useInput((ch, key) => {
+    if (key.upArrow) {
+      setActiveIdx(i => (i - 1 + flat.length) % Math.max(1, flat.length))
+
+      return
+    }
+
+    if (key.downArrow) {
+      setActiveIdx(i => (i + 1) % Math.max(1, flat.length))
+
+      return
+    }
+
+    if (key.return) {
+      flat[clamped]?.run()
+
+      return
+    }
+
+    if (key.escape) {
+      if (view === 'themes') {
+        // Revert the hover preview to the entry skin (preview parity).
+        const entry = entrySkinRef.current
+
+        if (entry) {
+          setCurrentSkin(entry)
+          setConfig('skin', entry)
+        }
+
+        go('commands')
+      } else if (view !== 'commands') {
+        go('commands')
+      } else {
+        onCancel()
+      }
+
+      return
+    }
+
+    if (key.backspace || key.delete) {
+      setFilter(v => v.slice(0, -1))
+      setActiveIdx(0)
+
+      return
+    }
+
+    if (ch && ch.length === 1 && !key.ctrl && !key.meta) {
+      setFilter(v => v + ch)
+      setActiveIdx(0)
+    }
+  })
+
+  let n = 0
+  const title = view === 'commands' ? 'Commands' : view === 'settings' ? 'Settings' : 'Themes'
+
+  return (
+    <Box flexDirection="column" width={60}>
+      <Box justifyContent="space-between">
+        <Text bold color={t.color.text}>
+          {title}
+        </Text>
+        <Text color={t.color.muted}>esc</Text>
+      </Box>
+      <Text color={t.color.muted}>{filter || 'Search'}</Text>
+      {visible.map(g => (
+        <Box flexDirection="column" key={g.group}>
+          <Text bold color={t.color.accent}>
+            {g.group}
+          </Text>
+          {g.items.map(r => {
+            const idx = n
+            n += 1
+            const selected = idx === clamped
+
+            return (
+              <Box
+                backgroundColor={selected ? t.color.selectionBg : undefined}
+                justifyContent="space-between"
+                key={r.label}
+              >
+                <Text bold={selected} color={t.color.text}>
+                  {r.label}
+                </Text>
+                <Text color={t.color.muted}>{r.value ?? r.hint ?? ''}</Text>
+              </Box>
+            )
+          })}
+        </Box>
+      ))}
+      {err ? <Text color={t.color.error}>{err}</Text> : null}
+    </Box>
+  )
+})
+
+export function openOpencodePalette() {
+  patchOverlayState({ opencodePalette: true })
+}
diff --git a/ui-tui/src/gatewayTypes.ts b/ui-tui/src/gatewayTypes.ts
index e82e83a4f2..4b101f537f 100644
--- a/ui-tui/src/gatewayTypes.ts
+++ b/ui-tui/src/gatewayTypes.ts
@@ -81,6 +81,9 @@ export interface ConfigDisplayConfig {
   /** Focus view (/focus) — display-only reduced-output mode. */
   focus_view?: boolean
   inline_diffs?: boolean
+  /** TUI visual layout: "classic" (default) | "opencode". Unknown values
+   *  fall back to classic at runtime. */
+  layout?: string
   /** UI language id (`en`, `pl`, `pt-br`); the TUI fetches its pack via `i18n.catalog`. */
   language?: string
   mouse_tracking?: boolean | null | number | string
