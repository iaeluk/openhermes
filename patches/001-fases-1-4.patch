+]
+
+const COLOR_MODES = ['auto', 'light', 'dark']
+
+interface PaletteRow {
+  hint?: string
+  label: string
+  run: () => void
+  value?: string
+}
+
+export interface OpencodePaletteProps {
+  onCancel: () => void
+  onNewSession: () => void
+  onOpenModelPicker: () => void
+  onOpenSessions: () => void
+  t: Theme
+}
+
+export const OpencodePalette = memo(function OpencodePalette({
+  onCancel,
+  onNewSession,
+  onOpenModelPicker,
+  onOpenSessions,
+  t
+}: OpencodePaletteProps) {
+  const { rpc } = useGateway()
+  const [view, setView] = useState<View>('commands')
+  const [filter, setFilter] = useState('')
+  const [activeIdx, setActiveIdx] = useState(0)
+  const [values, setValues] = useState<Record<string, string>>({})
+  const [currentSkin, setCurrentSkin] = useState('')
+  const [err, setErr] = useState('')
+
+  useEffect(() => {
+    if (view !== 'settings') {
+      return
+    }
+    void (async () => {
+      const out: Record<string, string> = {}
+
+      for (const k of ['display.layout', 'show_reasoning', 'tui_theme']) {
+        try {
+          const r = (await rpc('config.get', { key: k })) as { value?: unknown } | null
+          out[k] = String(r?.value ?? '')
+        } catch {
+          out[k] = ''
+        }
+      }
+
+      setValues(out)
+    })()
+  }, [rpc, view])
+
+  useEffect(() => {
+    if (view !== 'themes') {
+      return
+    }
+    void (async () => {
+      try {
+        const r = (await rpc('config.get', { key: 'skin' })) as { value?: unknown } | null
+        setCurrentSkin(String(r?.value ?? ''))
+      } catch {
+        setCurrentSkin('')
+      }
+    })()
+  }, [rpc, view])
+
+  const setConfig = (key: string, value: string, local?: Record<string, string>) => {
+    void (async () => {
+      try {
+        await rpc('config.set', { key, value })
+        setErr('')
+
+        if (local) {
+          setValues(prev => ({ ...prev, ...local }))
+        }
+      } catch (e) {
+        setErr(e instanceof Error ? e.message : String(e))
+      }
+    })()
+  }
+
+  const applyTheme = (name: string) => {
+    const suffix = detectLightMode() ? '-light' : ''
+    const skin = `oh-${name}${suffix}`
+    setCurrentSkin(skin)
+    setConfig('skin', skin)
+  }
+
+  const cycleColorMode = () => {
+    const cur = values['tui_theme'] || 'auto'
+    const next = COLOR_MODES[(COLOR_MODES.indexOf(cur) + 1) % COLOR_MODES.length] ?? 'auto'
+    setConfig('tui_theme', next, { tui_theme: next })
+  }
+
+  const go = (v: View) => {
+    setView(v)
+    setFilter('')
+    setActiveIdx(0)
+  }
+
+  const rows: { group: string; items: PaletteRow[] }[] = []
+
+  if (view === 'commands') {
+    rows.push(
+      {
+        group: 'Suggested',
+        items: [
+          { hint: 'ctrl+x l', label: 'Switch session', run: onOpenSessions },
+          { hint: 'ctrl+x m', label: 'Switch model', run: onOpenModelPicker },
+          { label: 'Open settings', run: () => go('settings') }
+        ]
+      },
+      {
+        group: 'Session',
+        items: [{ hint: 'ctrl+x n', label: 'New session', run: onNewSession }]
+      },
+      {
+        group: 'Appearance',
+        items: [
+          { label: 'Switch theme', run: () => go('themes') },
+          { label: 'Color mode', run: cycleColorMode }
+        ]
+      }
+    )
+  } else if (view === 'settings') {
+    const layout = values['display.layout'] || 'classic'
+    rows.push(
+      {
+        group: 'Appearance',
+        items: [
+          { label: 'Theme', run: () => go('themes'), value: currentSkin || values['skin'] },
+          {
+            label: 'Color mode',
+            run: cycleColorMode,
+            value: values['tui_theme'] || 'auto'
+          },
+          {
+            label: 'Layout',
+            run: () =>
+              setConfig('display.layout', layout === 'opencode' ? 'classic' : 'opencode', {
+                'display.layout': layout === 'opencode' ? 'classic' : 'opencode'
+              }),
+            value: layout
+          }
+        ]
+      },
+      {
+        group: 'Session',
+        items: [
+          { label: 'Model', run: onOpenModelPicker },
+          {
+            label: 'Reasoning',
+            run: () => {
+              const next = values['show_reasoning'] === 'false' ? 'true' : 'false'
+              setConfig('show_reasoning', next, { show_reasoning: next })
+            },
+            value: values['show_reasoning'] === 'false' ? 'off' : 'on'
+          }
+        ]
+      }
+    )
+  } else {
+    const q = filter.toLowerCase()
+    const light = detectLightMode() ? '-light' : ''
+    rows.push({
+      group: 'Themes',
+      items: THEME_NAMES.filter(n => n.includes(q)).map(n => {
+        const skin = `oh-${n}${light}`
+
+        return {
+          label: `${currentSkin === skin ? '● ' : '  '}${n}`,
+          run: () => {
+            applyTheme(n)
+            onCancel()
+          }
+        }
+      })
+    })
+  }
+
+  const q = filter.toLowerCase()
+
+  const visible =
+    view === 'themes'
+      ? rows
+      : rows
+          .map(g => ({
+            ...g,
+            items: g.items.filter(r => r.label.toLowerCase().includes(q))
+          }))
+          .filter(g => g.items.length > 0)
+
+  const flat = visible.flatMap(g => g.items)
+  const clamped = flat.length ? Math.min(activeIdx, flat.length - 1) : 0
+
+  useInput((ch, key) => {
+    if (key.upArrow) {
+      setActiveIdx(i => (i - 1 + flat.length) % Math.max(1, flat.length))
+
+      return
+    }
+
+    if (key.downArrow) {
+      setActiveIdx(i => (i + 1) % Math.max(1, flat.length))
+
+      return
+    }
+
+    if (key.return) {
+      flat[clamped]?.run()
+
+      return
+    }
+
+    if (key.escape) {
+      if (view !== 'commands') {
+        go('commands')
+      } else {
+        onCancel()
+      }
+
+      return
+    }
+
+    if (key.backspace || key.delete) {
+      setFilter(v => v.slice(0, -1))
+      setActiveIdx(0)
+
+      return
+    }
+
+    if (ch && ch.length === 1 && !key.ctrl && !key.meta) {
+      setFilter(v => v + ch)
+      setActiveIdx(0)
+    }
+  })
+
+  let n = 0
+  const title = view === 'commands' ? 'Commands' : view === 'settings' ? 'Settings' : 'Themes'
+
+  return (
+    <Box flexDirection="column" width={60}>
+      <Box justifyContent="space-between">
+        <Text bold color={t.color.text}>
+          {title}
+        </Text>
+        <Text color={t.color.muted}>esc</Text>
+      </Box>
+      <Text color={t.color.muted}>{filter || 'Search'}</Text>
+      {visible.map(g => (
+        <Box flexDirection="column" key={g.group}>
+          <Text bold color={t.color.accent}>
+            {g.group}
+          </Text>
+          {g.items.map(r => {
+            const idx = n
+            n += 1
+            const selected = idx === clamped
+
+            return (
+              <Box justifyContent="space-between" key={r.label}>
+                <Text
+                  backgroundColor={selected ? t.color.selectionBg : undefined}
+                  bold={selected}
+                  color={selected ? t.color.text : t.color.text}
+                >
+                  {r.label}
+                </Text>
+                <Text color={t.color.muted}>{r.value ?? r.hint ?? ''}</Text>
+              </Box>
+            )
+          })}
+        </Box>
+      ))}
+      {err ? <Text color={t.color.error}>{err}</Text> : null}
+    </Box>
+  )
+})
+
+export function openOpencodePalette() {
+  patchOverlayState({ opencodePalette: true })
+}
