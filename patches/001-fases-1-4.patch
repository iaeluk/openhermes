+
+  try {
+    const home = process.env.HERMES_HOME ?? join(homedir(), '.hermes')
+    const text = readFileSync(join(home, 'config.yaml'), 'utf8')
+    const lines = text.split('\n')
+    let inDisplay = false
+
+    for (const line of lines) {
+      if (/^display:\s*(#.*)?$/.test(line)) {
+        inDisplay = true
+
+        continue
+      }
+
+      if (inDisplay) {
+        if (/^\S/.test(line)) {
+          break
+        }
+
+        const m = /^\s+agent_name:\s*["']?(.{0,24})["']?\s*(#.*)?$/.exec(line)
+
+        if (m) {
+          return m[1].trim().slice(0, 24)
+        }
+      }
+    }
+  } catch {
+    // Unreadable config → empty default, gateway sync repairs it.
+  }
+
+  return ''
+}
+
+// openhermes: TUI-only skin override at boot (display.tui_skin).
