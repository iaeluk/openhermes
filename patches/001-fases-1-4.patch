+// openhermes: read display.layout straight from config.yaml at boot so the
+// first frame already uses the right chrome. Without this the TUI boots
+// classic and visibly flips once the gateway config arrives.
+const readBootLayout = (): 'classic' | 'opencode' => {
+  // Deterministic under test: suites must not depend on the real home file.
+  if (process.env.VITEST) {
+    return 'classic'
+  }
+
+  try {
+    const home = process.env.HERMES_HOME ?? join(homedir(), '.hermes')
+    const text = readFileSync(join(home, 'config.yaml'), 'utf8')
+    const lines = text.split('\n')
+    let inDisplay = false
+
+    for (const line of lines) {
+      if (/^display:\s*(#.*)?$/.test(line)) {
+        inDisplay = true
+
+        continue
+      }
+
+      if (inDisplay) {
+        if (/^\S/.test(line)) {
+          break
+        }
+
+        const m = /^\s+layout:\s*["']?(classic|opencode)["']?\s*(#.*)?$/.exec(line)
+
+        if (m?.[1] === 'opencode') {
+          return 'opencode'
+        }
+      }
+    }
+  } catch {
+    // Unreadable config → classic default, gateway sync repairs it.
+  }
+
+  return 'classic'
+}
+
+// openhermes: custom home-screen name at boot (display.agent_name, max 24).
